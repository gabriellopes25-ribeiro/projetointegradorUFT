FROM python:3.12-slim

WORKDIR /app

# Instala dependências de sistema para o driver psycopg2 do PostgreSQL
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# Inicializa o banco PostgreSQL (seeds + receitas reais da Prefeitura já salvas em data/bruto ou coleta ao vivo)
# e sobe imediatamente o Gateway FastAPI com os 4 Microsserviços e Agentes Estritos
CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000"]
